    "lucide-react": "^1.59.0",
    "lz-string": "^1.5.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^1.5.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
